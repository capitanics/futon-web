# Copy to .env and fill in. .env is gitignored.

# --- sync server ---
JWT_SECRET=change-me-openssl-rand-hex-32
DATABASE_USER=kotatsu
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me
DATABASE_NAME=kotatsu_db
SERVER_PORT=8080
# Reachable address for the phone (LAN IP or Tailscale hostname)
BASE_URL=http://localhost:8080
ALLOW_NEW_REGISTER=true

# --- futon-web app (same account you use in Futon) ---
SYNC_EMAIL=you@example.com
SYNC_PASSWORD=change-me
# host port for the web app container
APP_PORT=8090
